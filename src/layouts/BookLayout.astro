---
import '../styles/global.css'

interface Props {
  title?: string
}

const { title = 'Microbiology Stories and Sweets' } = Astro.props
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Micro Recipe Book</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Pacifico&family=Nunito:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="site-logo">
          <span class="logo-icon">🍰</span>
          <span class="logo-text">Micro Recipe Book</span>
        </a>
        <p class="header-tagline">Stories &amp; Sweets from the Lab</p>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <p>Made with 🧁 &amp; 🔬 by the microbiology team</p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    background: linear-gradient(
      135deg,
      var(--color-rose-light) 0%,
      var(--color-mint-light) 50%,
      var(--color-lavender-light) 100%
    );
    border-bottom: 2px solid var(--color-border);
    padding: 1.25rem 1.5rem;
  }

  .header-inner {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .site-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .logo-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--color-espresso);
    letter-spacing: 0.01em;
  }

  .header-tagline {
    font-size: 0.875rem;
    color: var(--color-muted);
    font-style: italic;
    font-weight: 600;
    margin: 0;
  }

  .site-main {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .site-footer {
    text-align: center;
    padding: 1.5rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    border-top: 2px dashed var(--color-border);
    background-color: var(--color-rose-light);
  }
</style>
