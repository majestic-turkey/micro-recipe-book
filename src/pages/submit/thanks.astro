---
import BookLayout from "../../layouts/BookLayout.astro";
---

<BookLayout>
    <h1>Thank You!</h1>
    <p>
        Your recipe submission has been received and will be added as soon as I
        can!
    </p>
    <a href="/">Back to the Recipe Book</a>
</BookLayout>

<style>
    p {
        font-size: 1.5rem;
        margin-bottom: 2rem;
    }
    a {
        display: block;
        width: fit-content;
        margin: 2rem auto 0;
        background-color: var(--color-rose-light);
        color: var(--color-red-dark);
        padding: 10px 20px;
        border: 1px solid var(--color-rose);
        border-radius: 50px;
        text-decoration: none;
        font-weight: bold;
        transition:
            background-color 0.2s ease,
            color 0.2s ease;
    }
</style>
