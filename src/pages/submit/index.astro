---
import BookLayout from "../../layouts/BookLayout.astro";
---

<BookLayout>
    <form
        name="recipe-submission"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/submit/thanks"
        enctype="multipart/form-data"
    >
        <input type="hidden" name="form-name" value="recipe-submission" />
        <input type="hidden" name="recipe-json" id="recipe-json" />
        <p hidden><label>Skip: <input name="bot-field" /></label></p>
        <label for="title">Recipe Title: </label><input
            type="text"
            id="title"
            name="title"
            placeholder="Grandma's Chocolate Chip Cookies"
            required
        />
        <label for="contributor">Your Name: </label><input
            type="text"
            id="contributor"
            name="contributor"
            placeholder="Penny Cillin"
            required
        />
        <label for="ingredients">Ingredients - one per line</label>
        <textarea id="ingredients" name="ingredients" rows="10" required placeholder="e.g. 2 cups all-purpose flour, sifted" />
        <label for="instructions">Instructions</label>
        <textarea id="instructions" name="instructions" rows="10" required placeholder="e.g. Preheat oven to 350°F (175°C)." />
        <label for="story">Story behind the recipe</label>
        <textarea id="story" name="story" rows="10" required placeholder="e.g. This recipe has been passed down in my family for generations..." />
        <label for="image">Image of the recipe (optional)</label>
        <input type="file" name="image" accept="image/*" />
        <button type="submit">Submit Recipe</button>
    </form>
</BookLayout>
<script>
    import { parseSubmission } from "../../lib/parser";

    const form = document.forms.namedItem("recipe-submission");
    const jsonField = document.getElementById(
        "recipe-json",
    ) as HTMLInputElement | null;

    form?.addEventListener("submit", () => {
        if (!jsonField) return;

        const titleField = document.getElementById(
            "title",
        ) as HTMLInputElement;
        const contributorField = document.getElementById(
            "contributor",
        ) as HTMLInputElement;
        const ingredientsField = document.getElementById(
            "ingredients",
        ) as HTMLTextAreaElement;
        const instructionsField = document.getElementById(
            "instructions",
        ) as HTMLTextAreaElement;
        const storyField = document.getElementById(
            "story",
        ) as HTMLTextAreaElement;

        try {
            const recipe = parseSubmission({
                title: titleField.value,
                contributor: contributorField.value,
                ingredients: ingredientsField.value,
                instructions: instructionsField.value,
                story: storyField.value,
            });
            jsonField.value = JSON.stringify(recipe, null, 2);
        } catch {
            // Leave recipe-json blank (response validated via required fields)
        }
    });
</script>
<style>
    form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    textarea, input {
        border: 1px solid var(--color-border);
        background-color: var(--color-cream-light);
        padding: 10px;
    }
    button {
        background-color: var(--color-rose);
        width: fit-content;
        border: 1px solid var(--color-rose);
        border-radius: 100px;
        padding: 10px 20px;
        cursor: pointer;
    }
</style>