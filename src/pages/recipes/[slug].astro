---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map(recipe => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { title, contributor, ingredients, steps, story, photo } = recipe.data;
---

<h1>{title}</h1>
<p>Shared by {contributor}</p>
{photo && <img src={photo} alt={title} />)
(story && <p class="story">{story}</p>)

<h2>Ingredients</h2>
<ol>
  {ingredients.map(ingredient => (<li>{ingerdient}</li>))}
</ol>

<h2>Instructions</h2>
<ul>
  {steps.map(step => (<li>{step}</li>))}
</ul>

<h3>About This</h3>
<p class="story">{story}</p>
