---
import BookLayout from '../../layouts/BookLayout.astro'
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map(recipe => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { title, contributor, ingredients, instructions, story, photo } = recipe.data;
---

<BookLayout title={title}>
  <div class="recipe-page">
    <a href="/" class="back-link">← Back to all recipes</a>

    <header class="recipe-header">
      {photo && (
        <div class="recipe-hero-img">
          <img src={photo} alt={title} />
        </div>
      )}
      <div class="recipe-title-block">
        <h1>{title}</h1>
        <p class="contributed-by">
          <span class="badge">🧁 Shared by</span>
          <span class="contributor-name">{contributor.split(' ')[0]}</span>
        </p>
      </div>
    </header>

    <div class="recipe-body">
      <div class="recipe-columns">
        <section class="recipe-section ingredients-section">
          <h2>
            <span class="section-icon">🛒</span>
            Ingredients
          </h2>
          <ol class="ingredients-list">
            {ingredients.map(ingredient => (
              <li>{ingredient}</li>
            ))}
          </ol>
        </section>

        <section class="recipe-section instructions-section">
          <h2>
            <span class="section-icon">👩‍🍳</span>
            Instructions
          </h2>
          <ol class="instructions-list">
            {instructions.map(step => (
              <li>
                <span class="step-text">{step}</span>
              </li>
            ))}
          </ol>
        </section>
      </div>

      {story && (
        <section class="story-section">
          <h2>
            <span class="section-icon">💬</span>
            The Story Behind This Recipe
          </h2>
          <blockquote class="story-text">{story}</blockquote>
        </section>
      )}
    </div>
  </div>
</BookLayout>

<style>
  .recipe-page {
    max-width: 800px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    text-decoration: none;
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    padding: 0.35rem 0.9rem;
    border: 1.5px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-card);
    transition: background 0.2s, border-color 0.2s;
  }

  .back-link:hover {
    background: var(--color-rose-light);
    border-color: var(--color-rose);
  }

  /* Header */
  .recipe-header {
    background: var(--color-card);
    border: 2px solid var(--color-border);
    border-radius: 1.5rem;
    overflow: hidden;
    margin-bottom: 1.75rem;
  }

  .recipe-hero-img {
    width: 100%;
    max-height: 380px;
    overflow: hidden;
  }

  .recipe-hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .recipe-title-block {
    padding: 1.5rem 1.75rem;
  }

  .recipe-title-block h1 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    color: var(--color-espresso);
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .contributed-by {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 0;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: var(--color-mint-light);
    border: 1.5px solid var(--color-mint);
    border-radius: 999px;
    padding: 0.2rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .contributor-name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-espresso);
  }

  /* Body layout */
  .recipe-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .recipe-columns {
    display: grid;
    grid-template-columns: 1fr 1.75fr;
    gap: 1.5rem;
    align-items: start;
  }

  @media (max-width: 600px) {
    .recipe-columns {
      grid-template-columns: 1fr;
    }
  }

  /* Sections */
  .recipe-section {
    background: var(--color-card);
    border: 2px solid var(--color-border);
    border-radius: 1.25rem;
    padding: 1.5rem;
  }

  .recipe-section h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-espresso);
    margin: 0 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px dashed var(--color-border);
  }

  .section-icon {
    font-size: 1.2rem;
  }

  .ingredients-section {
    border-top-color: var(--color-mint);
  }

  .instructions-section {
    border-top-color: var(--color-lavender);
  }

  /* Ingredients list */
  .ingredients-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    counter-reset: ingredient-counter;
  }

  .ingredients-list li {
    counter-increment: ingredient-counter;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-espresso);
    padding: 0.4rem 0.6rem;
    border-radius: 0.5rem;
    transition: background 0.15s;
  }

  .ingredients-list li:hover {
    background: var(--color-mint-light);
  }

  .ingredients-list li::before {
    content: counter(ingredient-counter);
    min-width: 1.4rem;
    height: 1.4rem;
    background: var(--color-mint);
    color: white;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 800;
    flex-shrink: 0;
  }

  /* Instructions list */
  .instructions-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    counter-reset: step-counter;
  }

  .instructions-list li {
    counter-increment: step-counter;
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
    line-height: 1.6;
    font-size: 0.9375rem;
  }

  .instructions-list li::before {
    content: counter(step-counter);
    min-width: 2rem;
    height: 2rem;
    background: linear-gradient(135deg, var(--color-lavender), var(--color-rose));
    color: white;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 800;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .step-text {
    color: var(--color-espresso);
  }

  /* Story section */
  .story-section {
    background: linear-gradient(
      135deg,
      var(--color-peach-light) 0%,
      var(--color-rose-light) 60%,
      var(--color-lavender-light) 100%
    );
    border: 2px solid var(--color-rose);
    border-radius: 1.25rem;
    padding: 1.75rem;
  }

  .story-section h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-espresso);
    margin: 0 0 1rem;
  }

  .story-text {
    margin: 0;
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-espresso);
    font-style: italic;
    border-left: 4px solid var(--color-rose);
    padding-left: 1.25rem;
  }
</style>
